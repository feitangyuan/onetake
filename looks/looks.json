{
  "about": "Starting looks, each measured from an accepted film and set in OFL faces that ship in looks/fonts. A look is picked by name in the concept round (SKILL.md §2), or made from the product with `look.py from-shot`; it is never a silent default. Every look has the same eight colours and three faces, so a comp written against the tokens can switch looks by name.",
  "tokens": {
    "ground": "the frame's ground — the 70 % of the picture",
    "deep": "a second ground: vignette edge, far plane, a well under cards",
    "card": "surfaces that sit on the ground",
    "line": "hairlines, card edges, lattice",
    "mute": "labels and secondary text; ≥ 3:1 on ground",
    "ink": "type and the subject; ≥ 4.5:1 on ground",
    "accent": "the one colour that means something",
    "accent2": "its partner, used rarely"
  },
  "faces": {
    "Inter": { "file": "Inter.ttf", "weight": "100 900", "pin": { "slnt": 0 }, "fallback": "system-ui, sans-serif" },
    "Instrument Sans": { "file": "InstrumentSans.ttf", "weight": "400 700", "pin": { "wdth": 100 }, "fallback": "system-ui, sans-serif" },
    "Instrument Serif": { "file": "InstrumentSerif.ttf", "weight": "400", "fallback": "Georgia, serif" },
    "Fraunces": { "file": "Fraunces.ttf", "weight": "100 900", "pin": { "SOFT": 0, "WONK": 0 }, "fallback": "Georgia, serif" },
    "Archivo": { "file": "Archivo.ttf", "weight": "100 900", "pin": { "wdth": 100 }, "fallback": "system-ui, sans-serif" },
    "Archivo Condensed": { "file": "Archivo.ttf", "weight": "100 900", "pin": { "wdth": 62 }, "fallback": "'Arial Narrow', sans-serif" },
    "Geist": { "file": "Geist.ttf", "weight": "100 900", "fallback": "system-ui, sans-serif" },
    "Geist Mono": { "file": "GeistMono.ttf", "weight": "100 900", "fallback": "ui-monospace, Menlo, monospace" }
  },
